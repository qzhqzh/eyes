#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

PYTHON=/usr/bin/python3
AGENT=/opt/eyes/agent/eyes-agent.py
ENV_FILE=/etc/eyes/agent.env

start_service() {
    [ -x "$PYTHON" ] || return 1
    [ -f "$AGENT" ] || return 1

    if [ -r "$ENV_FILE" ]; then
        set -a
        . "$ENV_FILE"
        set +a
    fi

    node_roles="${EYES_NODE_ROLES:-worker}"
    node_labels="${EYES_NODE_LABELS:-}"
    [ -n "$node_labels" ] || node_labels='{}'

    procd_open_instance
    procd_set_param command "$PYTHON" "$AGENT" --mode node
    procd_set_param env \
        EYES_AGENT_MODE=node \
        EYES_STATE_DIR=/var/lib/eyes \
        EYES_HUB_URL="${EYES_HUB_URL:-}" \
        EYES_ENROLL_TOKEN="${EYES_ENROLL_TOKEN:-}" \
        EYES_DISPLAY_NAME="${EYES_DISPLAY_NAME:-}" \
        EYES_NODE_ROLES="$node_roles" \
        EYES_NODE_LABELS="$node_labels" \
        EYES_ALLOW_INSECURE_HTTP="${EYES_ALLOW_INSECURE_HTTP:-}"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file "$ENV_FILE"
    procd_close_instance
}

reload_service() {
    stop
    start
}
