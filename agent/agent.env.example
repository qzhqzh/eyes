# Eyes Hub 的外部 HTTPS 地址。
EYES_HUB_URL=https://eyes.example.com

# 仅首次注册需要。注册成功后凭据写入 /var/lib/eyes/node.json，
# 可从本文件移除该 Token 并重启服务。
EYES_ENROLL_TOKEN=replace-with-hub-enrollment-token

# 受控测试网络临时使用明文 HTTP 时设为 1；生产环境保持未设置并使用 HTTPS。
# EYES_ALLOW_INSECURE_HTTP=1

# 节点展示和调度元数据。
EYES_DISPLAY_NAME=gpu-worker-01
EYES_NODE_ROLES=gpu-worker,worker
EYES_NODE_LABELS='{"eyes.io/site":"home","eyes.io/zone":"study"}'
